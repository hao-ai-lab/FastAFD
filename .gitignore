# pycache
__pycache__/
*.py[cod]
*$py.class

# installed packages
*.dist-info/
*.egg-info/

# json files
*.json
*.jsonl

# profiling data
*.nsys-rep
*.ncu-rep

# binaries
build/
dist/
*.tar.gz
cache/

# virtual environment
.venv/
.venv-*/
venv/
env/

# clangd config
.clangd

# .vscode
.vscode/
.coverage

# Local research state and generated output are not repository inputs.
/reports/
/data/
/htmlcov/
/.env
/.env.*
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Small, reviewed test fixtures and public presets may use structured data.
!tests/fixtures/**/*.json
!tests/fixtures/**/*.jsonl
!scripts/experiments/**/*.json
!scripts/experiments/**/*.jsonl
!scripts/benchmark/*.json
